 {
  "name": "02-zone2auto-fc-simulee",
  "description": "iPhone + tapis simulé : programme « Test Zone 2 Auto » avec FC simulée dépendant de la vitesse ; perte de FC 45 s, reprise manuelle puis réactivation du pilote.",
  "steps": [
   {
    "do": "launch",
    "on": "phone",
    "args": [
     "-FouleeScenario",
     "zone2auto",
     "-FouleeTestPrograms",
     "-FouleeAppearance",
     "system",
     "-FouleeSimHR",
     "-FouleeStartProgram",
     "Test Zone 2 Auto",
     "-FouleeScript",
     "hrgap@200-245,manual@265,autopilot@285"
    ]
   },
   {
    "do": "wait",
    "seconds": 30
   },
   {
    "do": "shot",
    "on": "phone",
    "label": "echauffement-progressif"
   },
   {
    "do": "wait",
    "seconds": 140
   },
   {
    "do": "shot",
    "on": "phone",
    "label": "pilote-fc-actif"
   },
   {
    "do": "wait",
    "seconds": 45
   },
   {
    "do": "shot",
    "on": "phone",
    "label": "perte-fc"
   },
   {
    "do": "wait",
    "seconds": 50
   },
   {
    "do": "shot",
    "on": "phone",
    "label": "controle-manuel"
   },
   {
    "do": "wait",
    "seconds": 110
   },
   {
    "do": "shot",
    "on": "phone",
    "label": "fin-seance-bilan"
   },
   {
    "do": "collect",
    "on": "phone",
    "expect": [
     {
      "file": "phone.json",
      "path": "statuses",
      "op": "contains",
      "value": "finished",
      "label": "séance terminée"
     },
     {
      "file": "phone.json",
      "path": "phases",
      "op": "contains",
      "value": "Zone 2 pilotée",
      "label": "phase pilotée atteinte"
     },
     {
      "file": "phone.json",
      "path": "phases",
      "op": "contains",
      "value": "Retour au calme",
      "label": "retour au calme atteint"
     },
     {
      "file": "phone.json",
      "path": "adjustments",
      "op": "lenge",
      "value": 2,
      "label": "au moins 2 ajustements automatiques"
     },
     {
      "file": "phone.json",
      "path": "autopilotModes",
      "op": "contains",
      "value": "heartRateLost",
      "label": "perte de FC détectée"
     },
     {
      "file": "phone.json",
      "path": "alerts",
      "op": "contains",
      "value": "FC indisponible",
      "label": "alerte perte de FC"
     },
     {
      "file": "phone.json",
      "path": "autopilotModes",
      "op": "contains",
      "value": "manual",
      "label": "contrôle manuel prioritaire"
     },
     {
      "file": "phone.json",
      "path": "maxBeltSpeed",
      "op": "le",
      "value": 7.05,
      "label": "jamais au-delà de 7 km/h (limite auto)"
     },
     {
      "file": "phone.json",
      "path": "finished.autoAdjustments",
      "op": "ge",
      "value": 2,
      "label": "ajustements enregistrés dans la séance"
     }
    ]
   }
  ]
 },
 {
  "name": "03-pause-deconnexion",
  "description": "iPhone + tapis simulé : transitions par paliers, pause/reprise, coupure Bluetooth pendant la séance puis reconnexion (aucun redémarrage automatique), reprise explicite, arrêt.",
  "steps": [
   {
    "do": "launch",
    "on": "phone",
    "args": [
     "-FouleeScenario",
     "pause",
     "-FouleeTestPrograms",
     "-FouleeAppearance",
     "system",
     "-FouleeSimHR",
     "-FouleeStartProgram",
     "Test enchaînement",
     "-FouleeScript",
     "pause@45,resume@60,linkloss@95,reconnect@110,resume@135,stop@175"
    ]
   },
   {
    "do": "wait",
    "seconds": 52
   },
   {
    "do": "shot",
    "on": "phone",
    "label": "pause"
   },
   {
    "do": "wait",
    "seconds": 53
   },
   {
    "do": "shot",
    "on": "phone",
    "label": "connexion-perdue"
   },
   {
    "do": "wait",
    "seconds": 15
   },
   {
    "do": "shot",
    "on": "phone",
    "label": "reconnecte-toujours-en-pause"
   },
   {
    "do": "wait",
    "seconds": 75
   },
   {
    "do": "shot",
    "on": "phone",
    "label": "fin"
   },
   {
    "do": "collect",
    "on": "phone",
    "expect": [
     {
      "file": "phone.json",
      "path": "requestedSpeeds",
      "op": "contains",
      "value": "6.0",
      "label": "transition 4 → 7 km/h par paliers (6 km/h)"
     },
     {
      "file": "phone.json",
      "path": "statuses",
      "op": "contains",
      "value": "paused(user)",
      "label": "pause utilisateur"
     },
     {
      "file": "phone.json",
      "path": "statuses",
      "op": "contains",
      "value": "paused(connectionLost)",
      "label": "pause sur perte de connexion"
     },
     {
      "file": "phone.json",
      "path": "statusAfterReconnect",
      "op": "eq",
      "value": "paused(connectionLost)",
      "label": "reconnexion : reste en pause"
     },
     {
      "file": "phone.json",
      "path": "requestedSpeedIncreasedWhileLinkLost",
      "op": "eq",
      "value": false,
      "label": "aucune accélération pendant la coupure"
     },
     {
      "file": "phone.json",
      "path": "startCommandsAfterLinkLoss",
      "op": "eq",
      "value": 0,
      "label": "aucun Start automatique après reconnexion"
     },
     {
      "file": "phone.json",
      "path": "statuses",
      "op": "contains",
      "value": "finished",
      "label": "arrêt final"
     }
    ]
   }
  ]
 },
