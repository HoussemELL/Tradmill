 {
  "name": "05-watch-lance-zone2auto",
  "description": "Scénario complet : la montre lance « Test Zone 2 Auto », l'iPhone démarre le tapis simulé, la montre envoie sa FC (simulée) par WatchConnectivity et le pilote l'utilise ; pause, reprise et arrêt depuis la montre.",
  "steps": [
   {
    "do": "terminate",
    "on": "phone"
   },
   {
    "do": "launch",
    "on": "phone",
    "args": [
     "-FouleeScenario",
     "watchsync",
     "-FouleeTestPrograms",
     "-FouleeAppearance",
     "system"
    ]
   },
   {
    "do": "wait",
    "seconds": 10
   },
   {
    "do": "launch",
    "on": "watch",
    "args": [
     "-FouleeScenario",
     "e2e",
     "-FouleeSimulated",
     "-FouleeAutoStart",
     "Test Zone 2 Auto",
     "-FouleeScript",
     "pause@150,resume@165,stop@300"
    ]
   },
   {
    "do": "wait",
    "seconds": 6
   },
   {
    "do": "shot",
    "on": "watch",
    "label": "demarrage"
   },
   {
    "do": "wait",
    "seconds": 40
   },
   {
    "do": "shot",
    "on": "watch",
    "label": "seance-en-cours"
   },
   {
    "do": "shot",
    "on": "phone",
    "label": "seance-lancee-depuis-montre"
   },
   {
    "do": "wait",
    "seconds": 115
   },
   {
    "do": "shot",
    "on": "watch",
    "label": "pause-depuis-montre"
   },
   {
    "do": "shot",
    "on": "phone",
    "label": "pause-recue"
   },
   {
    "do": "wait",
    "seconds": 60
   },
   {
    "do": "shot",
    "on": "watch",
    "label": "pilote-fc"
   },
   {
    "do": "shot",
    "on": "phone",
    "label": "pilote-fc-watch"
   },
   {
    "do": "wait",
    "seconds": 110
   },
   {
    "do": "shot",
    "on": "watch",
    "label": "fin"
   },
   {
    "do": "shot",
    "on": "phone",
    "label": "fin"
   },
   {
    "do": "collect",
    "on": "watch",
    "expect": [
     {
      "file": "watch.json",
      "path": "startRequested",
      "op": "eq",
      "value": true,
      "label": "demande de démarrage envoyée"
     },
     {
      "file": "watch.json",
      "path": "startAccepted",
      "op": "eq",
      "value": true,
      "label": "démarrage accepté par l'iPhone"
     },
     {
      "file": "watch.json",
      "path": "liveCount",
      "op": "gt",
      "value": 30,
      "label": "état en direct reçu de l'iPhone"
     },
     {
      "file": "watch.json",
      "path": "states",
      "op": "contains",
      "value": "paused",
      "label": "pause visible sur la montre"
     },
     {
      "file": "watch.json",
      "path": "states",
      "op": "contains",
      "value": "finished",
      "label": "fin visible sur la montre"
     },
     {
      "file": "watch.json",
      "path": "heartRatesSent",
      "op": "gt",
      "value": 20,
      "label": "FC envoyée par la montre"
     },
     {
      "file": "watch.json",
      "path": "phases",
      "op": "contains",
      "value": "Zone 2 pilotée",
      "label": "phase affichée sur la montre"
     },
     {
      "file": "watch.json",
      "path": "workoutEnded",
      "op": "eq",
      "value": true,
      "label": "exercice de la montre terminé"
     }
    ]
   },
   {
    "do": "collect",
    "on": "phone",
    "expect": [
     {
      "file": "phone.json",
      "path": "watchStartRequests",
      "op": "ge",
      "value": 1,
      "label": "demande reçue par l'iPhone"
     },
     {
      "file": "phone.json",
      "path": "watchHeartRates",
      "op": "gt",
      "value": 20,
      "label": "FC Apple Watch reçue"
     },
     {
      "file": "phone.json",
      "path": "hrSources",
      "op": "contains",
      "value": "Apple Watch",
      "label": "source FC = Apple Watch"
     },
     {
      "file": "phone.json",
      "path": "watchControls",
      "op": "contains",
      "value": "pause",
      "label": "pause depuis la montre"
     },
     {
      "file": "phone.json",
      "path": "watchControls",
      "op": "contains",
      "value": "stop",
      "label": "arrêt depuis la montre"
     },
     {
      "file": "phone.json",
      "path": "statuses",
      "op": "contains",
      "value": "paused(user)",
      "label": "séance mise en pause"
     },
     {
      "file": "phone.json",
      "path": "statuses",
      "op": "contains",
      "value": "finished",
      "label": "séance terminée"
     },
     {
      "file": "phone.json",
      "path": "adjustments",
      "op": "lenge",
      "value": 1,
      "label": "pilote FC : ajustement avec la FC de la montre"
     }
    ]
   }
  ]
 }
]